PORT=3460
# Optional bind host. Use 127.0.0.1 behind Nginx on Oracle; local development can keep the default.
HOST=0.0.0.0
# Optional persistent paths. Oracle systemd uses /var/lib/antardrishti/{data,outputs}.
DATA_DIR=
OUTPUT_DIR=
FFMPEG_PATH=ffmpeg
RENDER_CONCURRENCY=1

# Add your Google AI Studio API key here in your local .env file.
# Never upload .env or share this key.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Cloudflare Workers AI free-tier scene images.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_ENABLED=false
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4

# Buffer API key. Keep only in your private environment file.
BUFFER_API_KEY=

# Cloudinary unsigned video uploads. Restrict the unsigned preset to mp4/webm.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
