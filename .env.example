PORT=3460

# Add your Google AI Studio API key here in your local .env file.
# Never upload .env or share this key.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# AI scene-image generation uses the paid Gemini image API. Leave OFF until you explicitly want to pay.
GEMINI_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
