PORT=3460

# Add your Google AI Studio API key here in your local .env file.
# Never upload .env or share this key.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Optional self-hosted VoiceStudio API for your own cloned voice and expressive Hindi narration.
# Run VoiceStudio with VoxCPM2 enabled and create your clone profile in its app first.
# For a remote server, use HTTPS and its OMNIVOICE_API_KEY. Keep the key server-side only.
# Local same-machine example: http://127.0.0.1:3900
VOICE_STUDIO_BASE_URL=
VOICE_STUDIO_API_KEY=
VOICE_STUDIO_MODEL=voxcpm2
# Used by deploy/voicestudio-compose.yml. Keep cpu unless this host has a supported GPU runtime.
VOICE_STUDIO_VOXCPM_DEVICE=cpu

# Cloudflare Workers AI free-tier scene images. Get these from Cloudflare > Workers AI > Use REST API.
# Leave image generation OFF until both values are configured and verified.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_ENABLED=false
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4

# Buffer API key. Create it in Buffer Settings > API.
# Keep this only in your local .env file; never commit the real key.
BUFFER_API_KEY=

# Cloudinary unsigned video uploads for one-click Buffer publishing.
# Use a locked-down unsigned preset with video formats mp4/webm and eager MP4/H.264 transformation.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Admin dashboard login. Use a strong, private password (12+ characters).
# Generate a session secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production, login is mandatory and cookies are Secure.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set true to require login outside production. Leave false for local development without credentials.
ADMIN_AUTH_REQUIRED=false
